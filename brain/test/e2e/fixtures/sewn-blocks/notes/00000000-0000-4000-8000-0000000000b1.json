   "text": "Start 10 seconds a km slower than goal pace."
  },
  {
   "kind": {
    "code": "rust"
   },
   "text": "/// Finish time for 10 km at an even pace."
  },
  {
   "kind": {
    "code": "rust"
   },
   "text": "fn finish(pace: Pace) -> Duration {"
  },
  {
   "kind": {
    "code": "rust"
   },
   "text": "    Duration::from_secs(10 * pace.secs_per_km() as u64)"
  },
  {
   "kind": {
    "code": "rust"
   },
   "text": "}"
  },
  {
   "kind": {
    "code": "rust"
   },
   "text": "#[test]"
  },
  {
   "kind": {
    "code": "rust"
   },
   "text": "fn sub_50() { assert_eq!(finish(Pace::new(4, 55)), secs(2950)); } // 49:10, 50 s to spare"
  },
  {
   "kind": "quote",
   "text": "Run the mile you’re in."
  },
